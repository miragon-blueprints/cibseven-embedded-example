meta {
  name: Assert an incident was raised on the order task
  type: http
  seq: 4
}

get {
  url: {{engineRest}}/incident?processInstanceId={{processInstanceId}}&incidentType=failedJob
  body: none
  auth: none
}

script:pre-request {
  // The order job retries 3 times, 10s apart (R3/PT10S), before the incident is raised.
  // Wait out the retry window so the incident exists by the time we query.
  await new Promise((resolve) => setTimeout(resolve, 40000));
}

assert {
  res.status: eq 200
  res.body: length 1
  res.body[0].incidentType: eq failedJob
  res.body[0].failedActivityId: eq serviceTask_orderBike
}
