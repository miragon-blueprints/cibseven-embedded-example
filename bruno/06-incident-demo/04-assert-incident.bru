meta {
  name: Assert an incident was raised on the order task
  type: http
  seq: 4
}

get {
  url: {{engineRest}}/incident?processInstanceId={{processInstanceId}}&incidentType=failedJob
  body: none
  auth: none
}

script:pre-request {
  await pollEngine("/incident?processInstanceId=" + bru.getVar("processInstanceId")
    + "&incidentType=failedJob",
    (b) => Array.isArray(b) && b.length >= 1,
    { timeoutMs: 60000 });
}

assert {
  res.status: eq 200
  res.body: length 1
  res.body[0].incidentType: eq failedJob
  res.body[0].failedActivityId: eq serviceTask_orderBike
}
