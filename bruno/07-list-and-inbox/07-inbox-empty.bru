meta {
  name: The inbox no longer lists our application
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/tasks/clarify-alternative
  auth: none
}

script:pre-request {
  await pollApp("/api/tasks/clarify-alternative",
    (b, s) => s === 200 && Array.isArray(b) && !b.some((t) => t.applicationId === bru.getVar("applicationId")));
}

assert {
  res.status: eq 200
}

tests {
  test("our application has left the inbox", function () {
    const stillThere = res.getBody().some((t) => t.applicationId === bru.getVar("applicationId"));
    expect(stillThere).to.equal(false);
  });
}
