meta {
  name: Assert the application was cancelled
  type: http
  seq: 7
}

get {
  url: {{engineRest}}/history/activity-instance?processInstanceId={{processInstanceId}}&activityId=endEvent_applicationCancelled
  body: none
  auth: none
}

script:pre-request {
  await pollEngine("/history/activity-instance?processInstanceId=" + bru.getVar("processInstanceId")
    + "&activityId=endEvent_applicationCancelled",
    (b) => Array.isArray(b) && b.length >= 1);
}

assert {
  res.status: eq 200
  res.body: length 1
}
